+package org.jetbrains.compose.internal.publishing
+
+import org.gradle.api.Project
+
+/**
+ * Minimal local-build replacement for the Compose publishing helper.
+ *
+ * Skiko's runtime build only needs signing inputs from this type. Release
+ * upload tasks live in the excluded :ci project and are intentionally not
+ * part of the Hyper-V development build.
+ */
+class MavenCentralProperties(project: Project) {
+    val signArtifacts: Boolean =
+        project.providers.gradleProperty("signArtifacts")
+            .orNull
+            ?.toBooleanStrictOrNull()
+            ?: false
+
+    val signArtifactsKey =
+        project.providers.gradleProperty("signArtifactsKey")
+
+    val signArtifactsPassword =
+        project.providers.gradleProperty("signArtifactsPassword")
+}
